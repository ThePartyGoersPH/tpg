VITE_API_URL=http://localhost:3000
# Leave VITE_API_URL empty to use the relative /api path through the Vite dev
# proxy (no CORS in local dev). Production builds set the live https URL.
VITE_MANAGER_URL=http://localhost:5174
# Google Identity Services client ID (Cloud Console > Credentials).
# Must have this app's origin in its Authorized JavaScript origins.
# Production value lives in the VPS .env.production (baked at build time).
VITE_GOOGLE_CLIENT_ID=
