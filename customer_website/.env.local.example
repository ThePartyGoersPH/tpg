# ============================================================
# Frontend .env.local.example  (LOCAL DEVELOPMENT)
# Copy to .env.local in each frontend project folder.
# ============================================================
# Vite reads VITE_* vars at build/dev time. Set BEFORE `npm run dev` / `npm run build`.

# Backend API base URL. In local dev the Vite proxy handles /api, so you
# can leave this empty and use relative "/api" calls. If you want to bypass
# the proxy, set it to http://localhost:3000
VITE_API_URL=http://localhost:3000
# Bar owner portal URL (separate app). Local: bar owner app dev server.
VITE_BAR_OWNER_URL=http://localhost:5174
