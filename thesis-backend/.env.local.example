# ============================================================
# .env.local.example  (LOCAL DEVELOPMENT)
# Copy to .env.local and fill in values. Never commit .env.local.
# ============================================================

# ---- Core ----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# ---- Database (local MySQL/MariaDB) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=tpg

# ---- JWT ----
JWT_SECRET=local-dev-jwt-secret-change-me-must-be-at-least-32-chars

# ---- CORS (every local frontend port) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:5175

# ---- ID verification storage ----
# Must NOT be inside public/static/dist. Resolved to absolute at startup.
ID_STORAGE_PATH=./private-uploads
# 32 bytes as hex (64 hex chars) or base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ID_ENCRYPTION_KEY=
# At least 16 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ID_HASH_KEY=

# ---- OCR (Google Vision) ----
# Set to 'none' to disable OCR locally (no Vision calls). Use 'mock' for canned results.
OCR_PROVIDER=none
# Path to service account JSON (local only). Relative to backend root.
GOOGLE_APPLICATION_CREDENTIALS=./private-uploads/keys/vision-sa.json
# Low limit so local testing can't run up a bill.
OCR_MONTHLY_HARD_LIMIT=50
OCR_MAX_FILE_SIZE_MB=10
OCR_MAX_PAGES=10

# ---- Email ----
# false = print codes/links to console instead of sending
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="The Party Goers <noreply@thepartygoers.partygoers.online>"

# ---- ID verification policy ----
ID_MAX_ATTEMPTS=3
ID_RETENTION_DAYS_APPROVED=365
ID_RETENTION_DAYS_REJECTED=30

# ---- Misc ----
SUPPORT_EMAIL=support@thepartygoers.partygoers.online
TRUST_PROXY=false
CRON_ENABLED=true