DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=
PORT=
NODE_ENV=

APP_URL=

JWT_SECRET=

PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

PLATFORM_FEE_PERCENTAGE=

MAX_FILE_SIZE=
ALLOWED_IMAGE_TYPES=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Optional display name for outgoing mail; defaults to SMTP_USER.
MAIL_FROM=
# Preferred mail variable names (read first; SMTP_* kept as fallback).
# Port 587 (STARTTLS) or 465 (implicit TLS). Never port 25.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
# Explicit master switch: "true" sends real mail anywhere (production AND
# local testing). Anything else prints mail to the backend console instead.
MAIL_ENABLED=
# Mail provider: smtp (default) | resend | brevo. The HTTPS APIs never need
# outbound SMTP ports, so they work on clouds that block 587/465.
MAIL_PROVIDER=
RESEND_API_KEY=
BREVO_API_KEY=
# Public base URL used to build every link inside outgoing emails.
APP_URL=

GOOGLE_CLIENT_ID=
# Optional extra audiences (comma-separated), e.g. the Android OAuth client
# ID so Flutter sign-ins verify too.
GOOGLE_CLIENT_IDS=
# Optional extra CORS origins (comma-separated), e.g. the live domain.
CORS_EXTRA_ORIGINS=
# NOTE: no GOOGLE_CLIENT_SECRET / GOOGLE_CALLBACK_URL here on purpose — the
# backend verifies Google ID tokens (google-auth-library) and never performs
# a server-side code exchange, so there is no secret or callback to configure.

# --- Login brute-force protection (all optional; defaults shown) ---
# LOGIN_MAX_ATTEMPTS=4
# LOGIN_LOCK_BASE_MINUTES=5
# LOGIN_LOCK_MAX_MINUTES=60
# LOGIN_QUIET_RESET_HOURS=24
# LOGIN_IP_MAX_FAILURES=20
# LOGIN_IP_WINDOW_MINUTES=15
# LOGIN_IP_LOCK_MINUTES=5
# LOGIN_ROUTE_MAX=5
# LOGIN_ROUTE_WINDOW_MINUTES=15
# SECURITY_ALERT_EMAIL=

# --- Timezone Configuration ---
TZ=Asia/Manila
