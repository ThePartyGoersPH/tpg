# ============================================================
# .env.production.example  (PRODUCTION / VPS)
# Copy to .env on the server and fill in values. Never commit.
# ============================================================

# ---- Core ----
NODE_ENV=production
PORT=3000
APP_URL=https://thepartygoers.partygoers.online

# ---- Database ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=tpg_user
DB_PASS=
DB_NAME=tpg

# ---- JWT ----
JWT_SECRET=

# ---- CORS (production origin only) ----
CORS_ORIGINS=https://thepartygoers.partygoers.online

# ---- ID verification storage (absolute paths on the VPS) ----
ID_STORAGE_PATH=/var/lib/thepartygoers/private-uploads
ID_ENCRYPTION_KEY=
ID_HASH_KEY=

# ---- OCR (Google Vision) ----
OCR_PROVIDER=google_vision
GOOGLE_APPLICATION_CREDENTIALS=/etc/thepartygoers/vision-sa.json
OCR_MONTHLY_HARD_LIMIT=1000
OCR_MAX_FILE_SIZE_MB=10
OCR_MAX_PAGES=10

# ---- Email ----
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="The Party Goers <noreply@thepartygoers.partygoers.online>"

# ---- ID verification policy ----
ID_MAX_ATTEMPTS=3
ID_RETENTION_DAYS_APPROVED=365
ID_RETENTION_DAYS_REJECTED=30

# ---- Misc ----
SUPPORT_EMAIL=support@thepartygoers.partygoers.online
TRUST_PROXY=true
CRON_ENABLED=true